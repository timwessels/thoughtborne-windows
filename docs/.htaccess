# Cache policy: every response revalidates. "no-cache" still lets browsers
# store files — they just confirm freshness with a conditional request, and
# the server's ETag answers 304 when nothing changed. Without this header the
# host sent no cache policy at all, so browsers fell back to heuristic
# freshness and kept serving a stale screenshot/stylesheet for hours after a
# deploy. The site is a handful of small files; the 304 round-trips are noise.
# The ?v= query strings in the HTML stay as belt-and-braces.
<IfModule mod_headers.c>
  Header set Cache-Control "no-cache"
</IfModule>

# Canonical host: the www alias answered 200 with a full duplicate of the site
# (observed 2026-10-09), so search engines saw two sites with the same content.
# 301 everything on www over to the apex domain; the TLS certificate covers
# both names, so the https://www entry point handshakes fine before redirecting.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.thoughtborne\.app$ [NC]
  RewriteRule ^ https://thoughtborne.app%{REQUEST_URI} [R=301,L]
</IfModule>
