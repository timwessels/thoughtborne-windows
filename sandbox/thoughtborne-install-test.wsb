<Configuration>
  <!--
    Windows Sandbox config for the #76/#181 install verification (Win11
    Pro/Enterprise only; the sandbox feature is unavailable on Home). See
    sandbox/README.md.

    PORTABLE TEMPLATE -- do NOT hand-edit the mapped host-folder line below. It
    holds the placeholder token SANDBOX_HOSTFOLDER_ABS_PATH on purpose: the host
    launcher run-sandbox.ps1 copies this file to %TEMP% at run time and there
    substitutes the real absolute path of this "sandbox" folder (Windows Sandbox
    needs an absolute host path and does not expand environment variables). The
    tracked file stays a placeholder so it never carries a machine-specific path.

    The mapped folder carries the harness in, the throwaway key file in, and the
    logs/screenshots out (ReadOnly=false). The LogonCommand is argument-free here
    (defaults to 'local' mode if this template is ever launched by hand);
    run-sandbox.ps1 appends -Mode/-Version to the %TEMP% copy it generates.
  -->
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>SANDBOX_HOSTFOLDER_ABS_PATH</HostFolder>
      <SandboxFolder>C:\thoughtborne-share</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>powershell -NoProfile -ExecutionPolicy Bypass -File C:\thoughtborne-share\verify-in-sandbox.ps1</Command>
  </LogonCommand>
</Configuration>
