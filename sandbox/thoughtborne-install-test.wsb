<Configuration>
  <!--
    Windows Sandbox config for the #76/#181 install verification (Win11
    Pro/Enterprise only; the sandbox feature is unavailable on Home). See
    sandbox/README.md.

    PORTABLE TEMPLATE - do NOT hand-edit the mapped host-folder line below. It
    holds a placeholder token on purpose: the host launcher run-sandbox.ps1
    copies this file to %TEMP% at run time and there substitutes the real
    absolute path of this "sandbox" folder for that token (Windows Sandbox needs
    an absolute host path and does not expand environment variables). The tracked
    file stays a placeholder so it never carries a machine-specific path.

    The mapped folder carries the harness in, the throwaway key file in, and the
    logs/screenshots out (ReadOnly=false). run-sandbox.ps1 fills the run-args
    placeholder in the LogonCommand below with -Mode/-Version for the %TEMP%
    copy it generates; like the host-path token, that substitution is required
    - this template is not meant to be launched by hand.
  -->
  <!-- Default, NOT Enable: on the current Windows Sandbox Store app (Build
       26200+) the Enable value breaks the LogonCommand and the mapped-folder
       writeback (the sandbox boots but never reports a verdict), while Default
       enables networking the same way without the bug - verified #181 with a
       host-visible echo + HTTPS probe. Do not change Default back to Enable. -->
  <Networking>Default</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>SANDBOX_HOSTFOLDER_ABS_PATH</HostFolder>
      <SandboxFolder>C:\thoughtborne-share</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <!-- Wait for the mapped folder to mount before running the driver. On the
         current Windows Sandbox Store app the LogonCommand can fire a moment
         before C:\thoughtborne-share is mounted, so a bare -File load of the
         driver fails instantly (script not found), with no retry, and nothing
         runs - the sandbox boots but no out-*/RESULT.txt is ever produced
         (#181 E2E finding, validated by probe). The poll loop closes that race;
         run-sandbox.ps1 fills the run-args placeholder with -Mode/-Version. -->
    <Command>powershell -NoProfile -ExecutionPolicy Bypass -Command "$d='C:\thoughtborne-share\verify-in-sandbox.ps1'; for($i=0;$i -lt 90;$i++){ if(Test-Path -LiteralPath $d){ break } else { Start-Sleep -Seconds 2 } }; &amp; $d SANDBOX_VERIFY_ARGS"</Command>
  </LogonCommand>
  <!-- Disable: the harness never needs the host clipboard. Results travel out
       through the mapped folder, and the self test's own insert stays inside the
       VM. The sandbox's msrdc clipboard sync is the contention source observed in
       #225 (a silent paste miss on the host), so a verification run must never be
       able to disturb dictation on the host while it runs. Note this stops only
       host/sandbox clipboard SHARING; the sandbox's own clipboard, and with it the
       tool's clipboard insert path inside the VM, is unaffected. Store app caveat,
       same class as the Networking note above: confirm on the current build that a
       run still writes its verdict back before trusting this value. -->
  <ClipboardRedirection>Disable</ClipboardRedirection>
</Configuration>
